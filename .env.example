# =============================================================================
# task_ambi_v4 — .env.example（付3フェーズ成果物。設計版 2026-08-20・D15）
# -----------------------------------------------------------------------------
# - 実体 `.env` はリポジトリ直下に 1 つ（憲章 §5）。gitignore・権限 600。本ファイルは commit する。
# - ここに置くのは (a) 秘密 と (b) 環境依存値 だけ。挙動の設定は config.json（c1）／領域 A・B（c2）。
#   環境変数で config.json の値は上書きできない（D15-b: 各キーの正規の置き場は 1 つ）。
# - 読み手: app（apps/api。pydantic-settings が .env を読む。OS 環境変数が .env に勝つ）と
#   ui（apps/ui。(b) のうち APP_BASE_URL／APP_PORT／APP_HOST のみ。秘密は読まない）。
#   016 以降、ui は app と**同じプロセス**に同居するので、両者は同じ .env を同じ 1 回で読む。
# - systemd: 常駐は **app の 1 ユニットだけ**（EnvironmentFile= 不要。app 自身が .env を読む）。
#   016 で ui ユニットは廃止された（D23。UI は `/ui` で app に載る）。
# - 実値の控え（WSL／systemd の環境事実を含む）はリポジトリ外の「環境情報ファイル」に（x3_notes §6）。
# - 対応表: docs/design/appendix_env_design/x3_config_catalog.csv（CFG-01〜13。**CFG-13 は 016 で廃止**）
# =============================================================================

# ---------- (a) 秘密情報 ----------------------------------------------------
# LLM プロファイルごとの API キー。キー名は LLM_API_KEY_<PROFILE>（<PROFILE>＝global/llm_profiles.yaml の
# name を大文字化。D15-g）。llm_profiles.yaml の api_key_ref にこのキー名を書く。実値は executor だけが読む。
# ローカル LLM（llama-server 等）は空のままでよい。値をログ・例外・UI に出さない（D15-i）。
LLM_API_KEY_OPENROUTER=sk-or-v1-REPLACE_ME_DUMMY
LLM_API_KEY_LOCAL=

# ---------- (b) 環境依存値: ルート（絶対パス） ----------------------------------
# Obsidian vault のルート（Windows 側。/mnt/c の drvfs）。vault MOD だけが読む。未設定・不在→起動中断。
VAULT_ROOT=/mnt/c/Users/REPLACE_ME/Dropbox/vault
# 設定ファイル領域 A（settings 所有。projects/<key>/ と global/）。不在なら雛形を生成。
SETTINGS_ROOT=/home/REPLACE_ME/task_ambi_data/settings
# 設定ファイル領域 B（trigger 所有。triggers.yaml と history/）。
TRIGGER_ROOT=/home/REPLACE_ME/task_ambi_data/trigger
# beads: .beads ディレクトリ自身（直下に config.yaml。bd の公約。D19-a）。「.beads を持つ親」ではない。
# board MOD だけが読み bd には env で渡す（cwd 非依存 D19-c）。リポジトリ内には置かない（D19-d）。不在→起動中断。
BEADS_DIR=/home/REPLACE_ME/task_ambi_data/beads/.beads
# bd 実行ファイル。省略時 bd（PATH 解決）。systemd 下は PATH が最小なので絶対パス推奨。
BD_BIN=/home/REPLACE_ME/.local/bin/bd
# Windows のダウンロードフォルダ。file トリガーの watch_dir はこれに相対（既定 "."）。file トリガーを使うなら必須。
DOWNLOADS_DIR=/mnt/c/Users/REPLACE_ME/Downloads

# ---------- (b) 環境依存値: ポート・URL -------------------------------------------
# app（uvicorn）。bind は localhost のみ（認証認可は対象外 憲章 §10）。
APP_HOST=127.0.0.1
APP_PORT=8000
# ui（app に同居する NiceGUI の画面）が app を叩く base URL。
# 省略時は http://{APP_HOST}:{APP_PORT} から導出する。
APP_BASE_URL=http://127.0.0.1:8000
# ⚠ UI_PORT（CFG-13）は **016 で廃止**した —— UI は app と同じ待受に `/ui` で同居するので、
# UI 専用の待受ポートは無い（D23-e）。

# ---------- ここに置かないもの（誤配置の注意書き）-------------------------------
# - config.json のパス（規約の固定相対パスでコードが知る 憲章 §5）
# - LLM の base_url／model_id（global/llm_profiles.yaml のプロファイル属性 DEC-006／019）
# - 人間 actor 名（global/humans.yaml P5D-019）、上限値（global/limits.yaml）、トリガー定義（triggers.yaml）
# - CrewAI テレメトリ無効化（executor/config.json disable_crewai_telemetry → 起動時に setdefault）
# - BEADS_ACTOR（board が bd 呼び出しごとに設定する env。設定ではない）
